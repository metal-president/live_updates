<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Android 16+: lets ongoing notifications be promoted to Live Updates. -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

  <application>
    <receiver
      android:name="com.ttechapp.live_updates.LiveUpdatesDismissReceiver"
      android:exported="false" />
    <receiver
      android:name="com.ttechapp.live_updates.LiveUpdatesActionReceiver"
      android:exported="false" />
  </application>
</manifest>

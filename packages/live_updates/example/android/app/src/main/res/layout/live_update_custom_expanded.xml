<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded live update notification. Generated once by
  `dart run live_updates:create android` and yours to edit; see live_update_custom.xml
  for the view ids live_updates fills.

  live_update_extra_status shows LiveUpdateContent.extra['status']: add a
  view with the id live_update_extra_<key> for each extra value to show, and
  keep it hidden (gone) here so it only appears with a value.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/live_update_image"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/live_update_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

            <Chronometer
                android:id="@+id/live_update_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Time"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/live_update_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:visibility="gone" />

        <TextView
            android:id="@+id/live_update_extra_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Info"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/live_update_progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>

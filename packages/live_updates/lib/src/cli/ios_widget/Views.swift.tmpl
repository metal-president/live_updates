/// The value of one metric, with its unit. Timers are counted by the system.
struct LiveUpdatesMetricValue: View {
  let metric: LiveUpdatesMetric

  var body: some View {
    HStack(alignment: .firstTextBaseline, spacing: 2) {
      value.monospacedDigit().lineLimit(1)
      if let unit = metric.unit {
        Text(unit).font(.caption)
      }
    }
  }

  @ViewBuilder private var value: some View {
    switch (metric.type, metric.number) {
    case ("integer", let n?):
      Text(Int(exactly: n.rounded()) ?? 0, format: .number)
    case ("decimal", let n?):
      Text(n, format: .number.precision(.fractionLength(0...max(0, min(metric.fractionDigits ?? 1, 6)))))
    case ("timer", let ms?) where abs(ms) < 1e14:
      let end = Date(timeIntervalSince1970: ms / 1000)
      Text(timerInterval: min(Date(), end)...end, countsDown: true)
    case ("stopwatch", let ms?) where abs(ms) < 1e14:
      Text(Date(timeIntervalSince1970: ms / 1000), style: .timer)
    case ("pausedTimer", let ms?), ("pausedStopwatch", let ms?):
      Text(Duration.milliseconds(Int64(max(0, min(ms, 1e12)))), format: .time(pattern: .minuteSecond))
    default:
      Text(metric.text ?? "–")
    }
  }
}

/// `LiveUpdateContent.steps` as dots on a line, with the current stage named.
struct LiveUpdatesStepperRow: View {
  let state: LiveUpdatesAttributes.ContentState
  let palette: LiveUpdatesPalette

  var body: some View {
    if let steps = state.steps, !steps.labels.isEmpty {
      let total = steps.labels.count
      let current = max(0, min(steps.current, total - 1))
      // At most 8 dots: a window around the current stage.
      let first = max(0, min(current - 3, total - 8))
      let accent = palette.tint ?? .accentColor
      VStack(alignment: .leading, spacing: 6) {
        HStack(spacing: 0) {
          ForEach(first..<min(total, first + 8), id: \.self) { index in
            if index > first {
              Rectangle()
                .fill(index <= current ? accent : Color.secondary.opacity(0.4))
                .frame(height: 3)
            }
            Circle()
              .fill(index <= current ? accent : Color.secondary.opacity(0.4))
              .frame(width: index == current ? 14 : 9, height: index == current ? 14 : 9)
          }
        }
        HStack {
          Text(steps.labels[current]).font(.subheadline.weight(.semibold)).lineLimit(1)
            .foregroundStyle(palette.foreground ?? .primary)
          Spacer()
          Text("\(current + 1)/\(total)").font(.caption).monospacedDigit()
            .foregroundStyle(palette.secondaryText)
        }
      }
    }
  }
}


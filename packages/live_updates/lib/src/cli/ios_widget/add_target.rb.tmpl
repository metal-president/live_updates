# Adds the live_updates widget extension target to the Runner project.
# Generated and run by `dart run live_updates:create ios`.
require 'xcodeproj'

project_path, name, ext_dir, app_group = ARGV
project = Xcodeproj::Project.open(project_path)
ios_dir = File.dirname(project_path)

# The App Group is a per-configuration build setting, so flavors with
# different bundle ids (Debug-dev, Release-prod, ...) each get their own.
# Entitlements and Info.plist refer to it as $(LIVE_UPDATES_APP_GROUP).
GROUP_SETTING = 'LIVE_UPDATES_APP_GROUP'
GROUP_REF = "$(#{GROUP_SETTING})"
VALID_GROUP = /\Agroup\.[A-Za-z0-9.\-]+(\$\([A-Za-z0-9_]+\)[A-Za-z0-9.\-]*)*\z/

# Adds the App Group reference to an entitlements file (created when missing),
# replacing literal copies of the same groups written by older versions.
def add_app_group(path, literal_groups)
  plist = File.exist?(path) ? Xcodeproj::Plist.read_from_path(path) : {}
  groups = plist['com.apple.security.application-groups'] ||= []
  groups.reject! { |g| literal_groups.include?(g) }
  groups << GROUP_REF unless groups.include?(GROUP_REF)
  Xcodeproj::Plist.write_to_path(plist, path)
end

# Points every configuration of `target` at an entitlements file with the
# App Group, reusing one that is already configured, and sets the group.
def configure_app_group(project, target, ios_dir, default_rel, groups)
  target.build_configurations.each do |config|
    rel = config.build_settings['CODE_SIGN_ENTITLEMENTS'] || default_rel
    add_app_group(File.join(ios_dir, rel), groups.values)
    config.build_settings['CODE_SIGN_ENTITLEMENTS'] = rel
    group = groups[config.name] or
      abort("#{target.name} has a build configuration \"#{config.name}\" that Runner does not have. " \
            'Add it to Runner or pass --app-group.')
    config.build_settings[GROUP_SETTING] = group
  end
  dir, file = File.split(default_rel)
  group_ref = project.main_group.find_subpath(dir, false)
  if group_ref && group_ref.files.none? { |f| f.path == file }
    group_ref.new_reference(file)
  end
end

runner = project.targets.find { |t| t.name == 'Runner' } or abort('Runner target not found')

# Bundle id of the app per build configuration (flavors may differ).
app_ids = runner.build_configurations.to_h do |c|
  [c.name, c.build_settings['PRODUCT_BUNDLE_IDENTIFIER']]
end
missing = app_ids.select { |_, id| id.nil? || id.empty? }.keys
use_group = app_group && !app_group.empty?
if missing.any? && (app_group == 'auto')
  abort("PRODUCT_BUNDLE_IDENTIFIER is not set in Runner.xcodeproj for #{missing.join(', ')} " \
        '(set in an .xcconfig?). Pass --app-group group.<your bundle id>, or --no-app-group.')
end
groups = app_ids.to_h do |config, id|
  [config, app_group == 'auto' ? "group.#{id}" : app_group]
end
if use_group
  groups.each do |config, group|
    next if group =~ VALID_GROUP
    abort("App Group \"#{group}\" for #{config} is not valid. Pass --app-group group.<your bundle id>.")
  end
end

# Both targets read the App Group from this Info.plist key.
if use_group
  [File.join(ios_dir, 'Runner/Info.plist'), File.join(ext_dir, 'Info.plist')].each do |plist|
    next unless File.exist?(plist)
    unless system('/usr/libexec/PlistBuddy', '-c', "Set :LiveUpdatesAppGroup #{GROUP_REF}", plist,
                  out: File::NULL, err: File::NULL)
      system('/usr/libexec/PlistBuddy', '-c', "Add :LiveUpdatesAppGroup string #{GROUP_REF}", plist) or
        abort("Could not set LiveUpdatesAppGroup in #{plist}")
    end
  end
end

# LiveUpdatesActionIntent must be compiled into the app as well, since a
# LiveActivityIntent runs in the app process.
def ensure_shared_intent(project, targets, name)
  group = project.main_group.find_subpath(name, true)
  ref = group.files.find { |f| f.path == 'LiveUpdatesActionIntent.swift' } ||
        group.new_reference('LiveUpdatesActionIntent.swift')
  targets.each do |t|
    next if t.source_build_phase.files_references.include?(ref)
    t.source_build_phase.add_file_reference(ref)
  end
end

# Files added by newer plugin versions to an existing widget target (only
# the create command's own files, not anything else in the folder).
WIDGET_FILES = %w[LiveUpdatesAttributes.swift LiveUpdatesViews.swift LiveUpdatesActionIntent.swift].freeze

def ensure_widget_files(project, target, name, ext_dir)
  group = project.main_group.find_subpath(name, true)
  (WIDGET_FILES + ["#{name}LiveActivity.swift", "#{name}Bundle.swift"]).each do |file|
    next unless File.exist?(File.join(ext_dir, file))
    ref = group.files.find { |f| f.path == file } || group.new_reference(file)
    next if target.source_build_phase.files_references.include?(ref)
    target.source_build_phase.add_file_reference(ref)
  end
end

# The extension's asset catalog, for icons named with LiveUpdateIcon.native.
def ensure_assets(project, target, name, ext_dir)
  return unless File.directory?(File.join(ext_dir, 'Assets.xcassets'))
  group = project.main_group.find_subpath(name, true)
  ref = group.files.find { |f| f.path == 'Assets.xcassets' } || group.new_reference('Assets.xcassets')
  return if target.resources_build_phase.files_references.include?(ref)
  target.resources_build_phase.add_file_reference(ref)
end

# Live Activities can show from iOS 16.2. An existing extension (created
# for 17.2 before live_updates 0.4.0) is not changed, as layout code kept in
# it may need a newer iOS: this only tells the user how to support 16.2.
def report_deployment_target(project, target, name)
  values = target.build_configurations.map do |config|
    config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] ||
      project.build_configurations.find { |c| c.name == config.name }
        &.build_settings&.[]('IPHONEOS_DEPLOYMENT_TARGET')
  end.compact.uniq
  higher = values.select { |v| Gem::Version.correct?(v) && Gem::Version.new(v) > Gem::Version.new('16.2') }
  unknown = values.reject { |v| Gem::Version.correct?(v) }
  if higher.any?
    puts "#{name} targets iOS #{higher.join(', ')}; Live Activities can show from iOS 16.2. " \
         "To support iOS 16, lower the deployment target of #{name} to 16.2 in Xcode " \
         'and check that your layout builds for it (until then live_updates reports ' \
         'isSupported() false on older iOS versions).'
  elsif unknown.any? || values.empty?
    shown = unknown.any? ? " (#{unknown.join(', ')})" : ''
    puts "Could not read the deployment target of #{name}#{shown}. " \
         'Live Activities can show from iOS 16.2 when it is 16.2 or lower.'
  end
end

# Settings an .xcconfig file sets, following #include and #include? (the
# last assignment wins). Settings with a condition (KEY[sdk=...]) are left
# out; "$(inherited)" in a value is kept as it is.
def xcconfig_settings(path, project_dir = nil, seen = {}, depth = 0)
  settings = {}
  return settings if path.nil? || depth > 32 || !File.file?(path)
  real = (File.realpath(path) rescue path)
  return settings if seen[real]
  seen[real] = true
  File.foreach(path) do |line|
    line = line.strip
    if (m = line.match(/\A#include\??\s*"([^"]+)"/))
      # Relative to the including file, else to the project folder (as
      # Flutter's "Pods/Target Support Files/..." includes are).
      inc = File.expand_path(m[1], File.dirname(path))
      inc = File.expand_path(m[1], project_dir) if project_dir && !File.file?(inc)
      xcconfig_settings(inc, project_dir, seen, depth + 1).each do |k, v|
        settings[k] = settings.key?(k) ? v.gsub('$(inherited)', settings[k]) : v
      end
    elsif !line.start_with?('//') && (m = line.match(/\A([A-Za-z_]\w*)\s*=(.*)\z/))
      # String operations, not a regex, for the value (no backtracking).
      value = m[2]
      comment = value.index('//')
      value = value[0...comment] if comment
      value = value.strip
      value = value.chomp(';').rstrip
      # $(inherited) here is what earlier lines and includes set.
      value = value.gsub('$(inherited)', settings[m[1]]) if settings.key?(m[1])
      settings[m[1]] = value
    end
  end
  settings
end

# What `key` is for `config` of the widget without its own target-level
# value: its base .xcconfig file, else the project's configuration of the
# same name, else nil.
def inherited_setting(project, config, key)
  ref = config.base_configuration_reference
  path = ref && (ref.real_path.to_s rescue nil)
  value = xcconfig_settings(path, project.project_dir.to_s)[key]
  project_config = project.build_configurations.find { |c| c.name == config.name }
  base = project_config&.build_settings&.[](key)
  base = Array(base).join(' ') unless base.nil?
  resolved = value.nil? ? base : value.gsub('$(inherited)', base || '').strip
  resolved.nil? || resolved.strip.empty? ? nil : resolved
end

# Xcode previews (the #Preview blocks in the layout file) need an
# unoptimized build, and the preview samples are compiled only with DEBUG.
# Flutter's xcconfig files set neither, so debug configurations of the widget
# get them: those whose name contains "debug" (Debug, Debug-<flavor>,
# <flavor>-Debug). A setting is added at target level only when the value
# the configuration inherits (its .xcconfig, following #include, or the
# project) does not already provide it. Target-level values are kept (with
# a hint when they keep previews from working). Returns what was added and
# why, one line each.
def ensure_preview_settings(project, target)
  added = []
  target.build_configurations.each do |config|
    # By name only: a configuration that is unoptimized but distributed (such
    # as Staging) must not get DEBUG.
    next unless config.name.match?(/debug/i)
    s = config.build_settings
    where = "#{target.name} (#{config.name})"
    unless s.key?('SWIFT_OPTIMIZATION_LEVEL')
      inherited = inherited_setting(project, config, 'SWIFT_OPTIMIZATION_LEVEL')
      unless inherited == '-Onone'
        s['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone'
        added << "#{where}: SWIFT_OPTIMIZATION_LEVEL = -Onone " \
                 "(inherited: #{inherited || 'not set, so -O'})"
      end
    end
    unless s.key?('SWIFT_ACTIVE_COMPILATION_CONDITIONS')
      inherited = inherited_setting(project, config, 'SWIFT_ACTIVE_COMPILATION_CONDITIONS')
      unless inherited.to_s.split.include?('DEBUG')
        s['SWIFT_ACTIVE_COMPILATION_CONDITIONS'] = '$(inherited) DEBUG'
        added << "#{where}: DEBUG added to SWIFT_ACTIVE_COMPILATION_CONDITIONS " \
                 "(inherited: #{inherited.to_s.strip.empty? ? 'none' : inherited})"
      end
    end
    unless s.key?('ENABLE_PREVIEWS') || inherited_setting(project, config, 'ENABLE_PREVIEWS') == 'YES'
      s['ENABLE_PREVIEWS'] = 'YES'
      added << "#{where}: ENABLE_PREVIEWS = YES"
    end
    optimization = (s['SWIFT_OPTIMIZATION_LEVEL'] || '$(inherited)')
                   .gsub('$(inherited)', inherited_setting(project, config, 'SWIFT_OPTIMIZATION_LEVEL') || '')
                   .strip
    inherited = inherited_setting(project, config, 'SWIFT_ACTIVE_COMPILATION_CONDITIONS').to_s
    own = s['SWIFT_ACTIVE_COMPILATION_CONDITIONS']
    conditions = (own.nil? ? inherited : Array(own).join(' ').gsub('$(inherited)', inherited)).split
    unless optimization == '-Onone' && conditions.include?('DEBUG')
      puts "#{where}: Xcode previews need SWIFT_OPTIMIZATION_LEVEL -Onone and DEBUG in " \
           'SWIFT_ACTIVE_COMPILATION_CONDITIONS; kept your settings (see "Xcode previews" ' \
           'in the live_updates README).'
    end
  end
  added
end

if (existing = project.targets.find { |t| t.name == name })
  ensure_widget_files(project, existing, name, ext_dir)
  ensure_assets(project, existing, name, ext_dir)
  ensure_shared_intent(project, [runner, existing], name)
  report_deployment_target(project, existing, name)
  added = ensure_preview_settings(project, existing)
  unless added.empty?
    puts "Set the build settings Xcode previews need:\n  #{added.join("\n  ")}"
  end
  project.save
  if use_group
    configure_app_group(project, runner, ios_dir, 'Runner/Runner.entitlements', groups)
    configure_app_group(project, existing, ios_dir, "#{name}/#{name}.entitlements", groups)
    project.save
    puts "Target #{name} already exists; configured App Groups #{groups.values.uniq.join(', ')}."
  else
    puts "Target #{name} already exists; refreshed its files."
  end
  exit 0
end

target = project.new_target(:app_extension, name, :ios, '16.2', nil, :swift)
group = project.main_group.find_subpath(name, true)
group.set_source_tree('<group>')
group.set_path(name)

Dir.children(ext_dir).sort.each do |file|
  ref = group.new_reference(file)
  target.add_file_references([ref]) if file.end_with?('.swift')
end
ensure_assets(project, target, name, ext_dir)

target.build_configurations.each do |config|
  # Reuse Flutter's xcconfig so FLUTTER_BUILD_NAME/NUMBER are defined.
  runner_config = runner.build_configurations.find { |c| c.name == config.name }
  config.base_configuration_reference = runner_config&.base_configuration_reference
  s = config.build_settings
  s['PRODUCT_NAME'] = '$(TARGET_NAME)'
  # Per configuration, so each flavor's widget belongs to that flavor's app.
  app_id = app_ids[config.name]
  s['PRODUCT_BUNDLE_IDENTIFIER'] = app_id ? "#{app_id}.#{name}" : "$(inherited).#{name}"
  s['INFOPLIST_FILE'] = "#{name}/Info.plist"
  s['GENERATE_INFOPLIST_FILE'] = 'YES'
  s['INFOPLIST_KEY_CFBundleDisplayName'] = name
  s['MARKETING_VERSION'] = '$(FLUTTER_BUILD_NAME)'
  s['CURRENT_PROJECT_VERSION'] = '$(FLUTTER_BUILD_NUMBER)'
  s['IPHONEOS_DEPLOYMENT_TARGET'] = '16.2'
  s['SWIFT_VERSION'] = '5.0'
  s['TARGETED_DEVICE_FAMILY'] = '1,2'
  s['SKIP_INSTALL'] = 'YES'
  s['CODE_SIGN_STYLE'] = 'Automatic'
  team = runner_config&.build_settings&.dig('DEVELOPMENT_TEAM')
  s['DEVELOPMENT_TEAM'] = team if team
  s['LD_RUNPATH_SEARCH_PATHS'] = ['$(inherited)', '@executable_path/Frameworks', '@executable_path/../../Frameworks']
end
# new_target gave configurations it took for release ones (no DEBUG=1 in
# the project) optimized Swift settings: for debug-named ones, let the
# inherited values decide instead.
target.build_configurations.each do |config|
  next unless config.name.match?(/debug/i)
  %w[SWIFT_OPTIMIZATION_LEVEL SWIFT_COMPILATION_MODE SWIFT_ACTIVE_COMPILATION_CONDITIONS]
    .each { |k| config.build_settings.delete(k) }
end
added = ensure_preview_settings(project, target)
puts "Set the build settings Xcode previews need:\n  #{added.join("\n  ")}" unless added.empty?

%w[WidgetKit SwiftUI].each do |fw|
  target.frameworks_build_phase.add_file_reference(
    project.frameworks_group.new_file("System/Library/Frameworks/#{fw}.framework", :sdk_root)
  )
end

runner.add_dependency(target)
embed = runner.copy_files_build_phases.find { |p| p.name == 'Embed Foundation Extensions' } ||
        runner.new_copy_files_build_phase('Embed Foundation Extensions')
embed.dst_subfolder_spec = Xcodeproj::Constants::COPY_FILES_BUILD_PHASE_DESTINATIONS[:plug_ins]
build_file = embed.add_file_reference(target.product_reference, true)
build_file.settings = { 'ATTRIBUTES' => ['RemoveHeadersOnCopy'] }

# The embed phase must run before Flutter's "Thin Binary" script.
thin = runner.build_phases.find { |p| p.respond_to?(:name) && p.name == 'Thin Binary' }
if thin
  runner.build_phases.delete(embed)
  runner.build_phases.insert(runner.build_phases.index(thin), embed)
end

if use_group
  configure_app_group(project, runner, ios_dir, 'Runner/Runner.entitlements', groups)
  configure_app_group(project, target, ios_dir, "#{name}/#{name}.entitlements", groups)
end
ensure_shared_intent(project, [runner, target], name)

project.save
puts "Added target #{name} for #{app_ids.values.compact.uniq.join(', ')}."

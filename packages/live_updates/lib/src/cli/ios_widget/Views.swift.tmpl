/// `IosLiveUpdateOptions.color`, `backgroundColor` and `foregroundColor`, or
/// system colors while
/// the Always-On display dims the Lock Screen.
struct LiveUpdatesPalette {
  let tint: Color?
  let background: Color?
  /// Lock Screen text (`IosLiveUpdateOptions.foregroundColor`).
  let foreground: Color?

  /// Secondary text: the foreground color at 70%, else the system's.
  var secondaryText: AnyShapeStyle {
    foreground.map { AnyShapeStyle($0.opacity(0.7)) } ?? AnyShapeStyle(.secondary)
  }

  init(_ state: LiveUpdatesAttributes.ContentState, luminanceReduced: Bool) {
    tint = luminanceReduced ? nil : Self.color(state.tintArgb)
    background = luminanceReduced ? nil : Self.color(state.backgroundArgb)
    foreground = luminanceReduced ? nil : Self.color(state.foregroundArgb)
  }

  private init(tint: Color?) {
    self.tint = tint
    background = nil
    foreground = nil
  }

  /// The accent alone, for the Dynamic Island (whose background stays dark).
  var islandOnly: LiveUpdatesPalette { LiveUpdatesPalette(tint: tint) }

  static func color(_ argb: Int?) -> Color? {
    guard let argb, argb >= 0, argb <= 0xFFFF_FFFF else { return nil }
    func channel(_ shift: Int) -> Double { Double((argb >> shift) & 0xFF) / 255 }
    return Color(.sRGB, red: channel(16), green: channel(8), blue: channel(0), opacity: channel(24))
  }
}

/// One small item of the Dynamic Island: "progress", "timer", "title",
/// "body", "icon" or "extra:<key>".
struct LiveUpdatesIslandItem: View {
  let state: LiveUpdatesAttributes.ContentState
  let content: String?

  var body: some View {
    switch content {
    case "progress":
      if let progress = state.progress {
        ProgressView(value: progress).progressViewStyle(.circular)
      }
    case "timer":
      LiveUpdatesTimerText(state: state).frame(maxWidth: 52)
    case "icon":
      LiveUpdatesIslandIcon(state: state)
    case let text?:
      if let value = state.liveUpdatesText(text) {
        LiveUpdatesNarrowText(text: value)
      }
    case nil:
      EmptyView()
    }
  }
}


/// `LiveUpdateContent.timer`, counted by the system: it keeps running without
/// updates. A countdown stops at zero.
struct LiveUpdatesTimerText: View {
  let state: LiveUpdatesAttributes.ContentState

  var body: some View {
    Group {
      if let end = state.liveUpdatesTimerEnd {
        let now = Date()
        Text(timerInterval: min(now, end)...end, countsDown: true)
      } else if let start = state.liveUpdatesTimerStart {
        Text(start, style: .timer)
      }
    }
    .monospacedDigit()
    .multilineTextAlignment(.trailing)
  }
}

/// `LiveUpdateContent.actions`. Background actions run
/// `LiveUpdatesActionIntent`; `opensApp` actions open the app with a URL.
struct LiveUpdatesActionButtons: View {
  let actions: [LiveUpdatesAction]
  let activityID: String

  var body: some View {
    if !actions.isEmpty {
      HStack(spacing: 8) {
        ForEach(actions) { action in
          if action.opensApp, let url = action.liveUpdatesURL(activityID: activityID) {
            Link(destination: url) { LiveUpdatesActionLabel(action: action) }
          } else if action.requiresUnlock {
            Button(
              intent: LiveUpdatesSecureActionIntent(activityId: activityID, actionId: action.id)
            ) {
              LiveUpdatesActionLabel(action: action)
            }
          } else {
            Button(intent: LiveUpdatesActionIntent(activityId: activityID, actionId: action.id)) {
              LiveUpdatesActionLabel(action: action)
            }
          }
        }
      }
      .buttonStyle(.bordered)
    }
  }
}

struct LiveUpdatesActionLabel: View {
  let action: LiveUpdatesAction

  var body: some View {
    if let symbol = action.systemImage {
      Label(action.title, systemImage: symbol).frame(maxWidth: .infinity)
    } else {
      Text(action.title).frame(maxWidth: .infinity)
    }
  }
}

/// The image passed as `LiveUpdateContent.image`, else the icon.
struct LiveUpdatesThumbnail: View {
  let state: LiveUpdatesAttributes.ContentState

  var body: some View {
    if let url = LiveUpdatesImages.url(state.image),
      let image = UIImage(contentsOfFile: url.path)
    {
      Image(uiImage: image)

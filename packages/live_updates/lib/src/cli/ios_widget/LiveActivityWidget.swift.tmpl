import ActivityKit
import SwiftUI
import WidgetKit

/// Live Activity UI for live_updates. Generated by
/// `dart run live_updates:create_widget`; edit freely.
struct {{name}}LiveActivity: Widget {
  var body: some WidgetConfiguration {
    ActivityConfiguration(for: LiveUpdatesAttributes.self) { context in
      LockScreenView(state: context.state, activityID: context.activityID)
        .padding()
        .widgetURL(context.state.tapURL)
    } dynamicIsland: { context in
      DynamicIsland {
        DynamicIslandExpandedRegion(.leading) {
          Thumbnail(state: context.state).frame(width: 36, height: 36)
        }
        DynamicIslandExpandedRegion(.trailing) {
          if let progress = context.state.progress {
            Text(progress, format: .percent.precision(.fractionLength(0)))
              .font(.headline)
          }
        }
        DynamicIslandExpandedRegion(.center) {
          Text(context.state.title).font(.headline).lineLimit(1)
        }
        DynamicIslandExpandedRegion(.bottom) {
          VStack(alignment: .leading, spacing: 6) {
            if let body = context.state.body {
              Text(body).font(.subheadline).foregroundStyle(.secondary)
            }
            if let progress = context.state.progress {
              ProgressView(value: progress)
            }
            ActionButtons(actions: context.state.actions, activityID: context.activityID)
          }
        }
      } compactLeading: {
        Thumbnail(state: context.state)
      } compactTrailing: {
        if let progress = context.state.progress {
          ProgressView(value: progress).progressViewStyle(.circular)
        } else {
          Text(context.state.title).lineLimit(1).frame(maxWidth: 64)
        }
      } minimal: {
        if let progress = context.state.progress {
          ProgressView(value: progress).progressViewStyle(.circular)
        } else {
          AppIcon(name: context.state.iconName)
        }
      }
      .widgetURL(context.state.tapURL)
    }
  }
}

private struct LockScreenView: View {
  let state: LiveUpdatesAttributes.ContentState
  let activityID: String

  var body: some View {
    VStack(spacing: 10) {
      content
      ActionButtons(actions: state.actions, activityID: activityID)
    }
  }

  private var content: some View {
    HStack(alignment: .center, spacing: 12) {
      Thumbnail(state: state).frame(width: 40, height: 40)
      VStack(alignment: .leading, spacing: 4) {
        Text(state.title).font(.headline).lineLimit(1)
        if let body = state.body {
          Text(body).font(.subheadline).foregroundStyle(.secondary).lineLimit(2)
        }
        if let progress = state.progress {
          ProgressView(value: progress)
        }
      }
    }
  }
}

/// `LiveUpdateContent.actions`. Background actions run
/// `LiveUpdatesActionIntent`; `opensApp` actions open the app with a URL.
private struct ActionButtons: View {
  let actions: [LiveUpdatesAction]
  let activityID: String

  var body: some View {
    if !actions.isEmpty {
      HStack(spacing: 8) {
        ForEach(actions) { action in
          if action.opensApp, let url = action.url(activityID: activityID) {
            Link(destination: url) { ActionLabel(action: action) }
          } else {
            Button(intent: LiveUpdatesActionIntent(activityId: activityID, actionId: action.id)) {
              ActionLabel(action: action)
            }
          }
        }
      }
      .buttonStyle(.bordered)
    }
  }
}

private struct ActionLabel: View {
  let action: LiveUpdatesAction

  var body: some View {
    if let symbol = action.systemImage {
      Label(action.title, systemImage: symbol).frame(maxWidth: .infinity)
    } else {
      Text(action.title).frame(maxWidth: .infinity)
    }
  }
}

/// The image passed as `LiveUpdateContent.image`, else the icon.
private struct Thumbnail: View {
  let state: LiveUpdatesAttributes.ContentState

  var body: some View {
    if let url = LiveUpdatesImages.url(state.image),
      let image = UIImage(contentsOfFile: url.path)
    {
      Image(uiImage: image)
        .resizable()
        .scaledToFill()
        .clipShape(RoundedRectangle(cornerRadius: 8))
    } else {
      AppIcon(name: state.iconName)
    }
  }
}

private struct AppIcon: View {
  let name: String?

  var body: some View {
    if let name {
      Image(name).resizable().scaledToFit()
    } else {
      Image(systemName: "bolt.circle.fill").resizable().scaledToFit()
    }
  }
}

/// Must match LiveUpdatesBridge.tapScheme in the plugin:
/// "liveupdates-<app bundle id>", registered in Runner's Info.plist.
private func appURL(host: String, _ items: [URLQueryItem]) -> URL? {
  let appBundleId = (Bundle.main.bundleIdentifier ?? "")
    .split(separator: ".").dropLast().joined(separator: ".")
  var components = URLComponents()
  components.scheme = "liveupdates-\(appBundleId)"
  components.host = host
  components.queryItems = items
  return components.url
}

extension LiveUpdatesAttributes.ContentState {
  /// Delivered to `LiveUpdates.onTap` in Dart.
  var tapURL: URL? {
    guard let route else { return nil }
    return appURL(host: "tap", [URLQueryItem(name: "route", value: route)])
  }
}

extension LiveUpdatesAction {
  /// Opens the app and delivers the press to `LiveUpdates.onAction`.
  func url(activityID: String) -> URL? {
    appURL(
      host: "action",
      [URLQueryItem(name: "activity", value: activityID), URLQueryItem(name: "action", value: id)])
  }
}

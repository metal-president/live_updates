# Adds the live_updates widget extension target to the Runner project.
# Generated and run by `dart run live_updates:create_widget`.
require 'xcodeproj'

project_path, name, ext_dir, app_group = ARGV
project = Xcodeproj::Project.open(project_path)
ios_dir = File.dirname(project_path)

# The App Group is a per-configuration build setting, so flavors with
# different bundle ids (Debug-dev, Release-prod, ...) each get their own.
# Entitlements and Info.plist refer to it as $(LIVE_UPDATES_APP_GROUP).
GROUP_SETTING = 'LIVE_UPDATES_APP_GROUP'
GROUP_REF = "$(#{GROUP_SETTING})"
VALID_GROUP = /\Agroup\.[A-Za-z0-9.\-]+(\$\([A-Za-z0-9_]+\)[A-Za-z0-9.\-]*)*\z/

# Adds the App Group reference to an entitlements file (created when missing),
# replacing literal copies of the same groups written by older versions.
def add_app_group(path, literal_groups)
  plist = File.exist?(path) ? Xcodeproj::Plist.read_from_path(path) : {}
  groups = plist['com.apple.security.application-groups'] ||= []
  groups.reject! { |g| literal_groups.include?(g) }
  groups << GROUP_REF unless groups.include?(GROUP_REF)
  Xcodeproj::Plist.write_to_path(plist, path)
end

# Points every configuration of `target` at an entitlements file with the
# App Group, reusing one that is already configured, and sets the group.
def configure_app_group(project, target, ios_dir, default_rel, groups)
  target.build_configurations.each do |config|
    rel = config.build_settings['CODE_SIGN_ENTITLEMENTS'] || default_rel
    add_app_group(File.join(ios_dir, rel), groups.values)
    config.build_settings['CODE_SIGN_ENTITLEMENTS'] = rel
    config.build_settings[GROUP_SETTING] = groups.fetch(config.name)
  end
  dir, file = File.split(default_rel)
  group_ref = project.main_group.find_subpath(dir, false)
  if group_ref && group_ref.files.none? { |f| f.path == file }
    group_ref.new_reference(file)
  end
end

runner = project.targets.find { |t| t.name == 'Runner' } or abort('Runner target not found')

# Bundle id of the app per build configuration (flavors may differ).
app_ids = runner.build_configurations.to_h do |c|
  [c.name, c.build_settings['PRODUCT_BUNDLE_IDENTIFIER']]
end
missing = app_ids.select { |_, id| id.nil? || id.empty? }.keys
use_group = app_group && !app_group.empty?
if missing.any? && (app_group == 'auto')
  abort("PRODUCT_BUNDLE_IDENTIFIER is not set in Runner.xcodeproj for #{missing.join(', ')} " \
        '(set in an .xcconfig?). Pass --app-group group.<your bundle id>, or --no-app-group.')
end
groups = app_ids.to_h do |config, id|
  [config, app_group == 'auto' ? "group.#{id}" : app_group]
end
if use_group
  groups.each do |config, group|
    next if group =~ VALID_GROUP
    abort("App Group \"#{group}\" for #{config} is not valid. Pass --app-group group.<your bundle id>.")
  end
end

# Both targets read the App Group from this Info.plist key.
if use_group
  [File.join(ios_dir, 'Runner/Info.plist'), File.join(ext_dir, 'Info.plist')].each do |plist|
    next unless File.exist?(plist)
    unless system('/usr/libexec/PlistBuddy', '-c', "Set :LiveUpdatesAppGroup #{GROUP_REF}", plist,
                  out: File::NULL, err: File::NULL)
      system('/usr/libexec/PlistBuddy', '-c', "Add :LiveUpdatesAppGroup string #{GROUP_REF}", plist) or
        abort("Could not set LiveUpdatesAppGroup in #{plist}")
    end
  end
end

# LiveUpdatesActionIntent must be compiled into the app as well, since a
# LiveActivityIntent runs in the app process.
def ensure_shared_intent(project, targets, name)
  group = project.main_group.find_subpath(name, true)
  ref = group.files.find { |f| f.path == 'LiveUpdatesActionIntent.swift' } ||
        group.new_reference('LiveUpdatesActionIntent.swift')
  targets.each do |t|
    next if t.source_build_phase.files_references.include?(ref)
    t.source_build_phase.add_file_reference(ref)
  end
end

if (existing = project.targets.find { |t| t.name == name })
  ensure_shared_intent(project, [runner, existing], name)
  project.save
  if use_group
    configure_app_group(project, runner, ios_dir, 'Runner/Runner.entitlements', groups)
    configure_app_group(project, existing, ios_dir, "#{name}/#{name}.entitlements", groups)
    project.save
    puts "Target #{name} already exists; configured App Groups #{groups.values.uniq.join(', ')}."
  else
    puts "Target #{name} already exists; skipping Xcode changes."
  end
  exit 0
end

target = project.new_target(:app_extension, name, :ios, '17.2', nil, :swift)
group = project.main_group.find_subpath(name, true)
group.set_source_tree('<group>')
group.set_path(name)

Dir.children(ext_dir).sort.each do |file|
  ref = group.new_reference(file)
  target.add_file_references([ref]) if file.end_with?('.swift')
end

target.build_configurations.each do |config|
  # Reuse Flutter's xcconfig so FLUTTER_BUILD_NAME/NUMBER are defined.
  runner_config = runner.build_configurations.find { |c| c.name == config.name }
  config.base_configuration_reference = runner_config&.base_configuration_reference
  s = config.build_settings
  s['PRODUCT_NAME'] = '$(TARGET_NAME)'
  # Per configuration, so each flavor's widget belongs to that flavor's app.
  app_id = app_ids[config.name]
  s['PRODUCT_BUNDLE_IDENTIFIER'] = app_id ? "#{app_id}.#{name}" : "$(inherited).#{name}"
  s['INFOPLIST_FILE'] = "#{name}/Info.plist"
  s['GENERATE_INFOPLIST_FILE'] = 'YES'
  s['INFOPLIST_KEY_CFBundleDisplayName'] = name
  s['MARKETING_VERSION'] = '$(FLUTTER_BUILD_NAME)'
  s['CURRENT_PROJECT_VERSION'] = '$(FLUTTER_BUILD_NUMBER)'
  s['IPHONEOS_DEPLOYMENT_TARGET'] = '17.2'
  s['SWIFT_VERSION'] = '5.0'
  s['TARGETED_DEVICE_FAMILY'] = '1,2'
  s['SKIP_INSTALL'] = 'YES'
  s['CODE_SIGN_STYLE'] = 'Automatic'
  team = runner_config&.build_settings&.dig('DEVELOPMENT_TEAM')
  s['DEVELOPMENT_TEAM'] = team if team
  s['LD_RUNPATH_SEARCH_PATHS'] = ['$(inherited)', '@executable_path/Frameworks', '@executable_path/../../Frameworks']
end

%w[WidgetKit SwiftUI].each do |fw|
  target.frameworks_build_phase.add_file_reference(
    project.frameworks_group.new_file("System/Library/Frameworks/#{fw}.framework", :sdk_root)
  )
end

runner.add_dependency(target)
embed = runner.copy_files_build_phases.find { |p| p.name == 'Embed Foundation Extensions' } ||
        runner.new_copy_files_build_phase('Embed Foundation Extensions')
embed.dst_subfolder_spec = Xcodeproj::Constants::COPY_FILES_BUILD_PHASE_DESTINATIONS[:plug_ins]
build_file = embed.add_file_reference(target.product_reference, true)
build_file.settings = { 'ATTRIBUTES' => ['RemoveHeadersOnCopy'] }

# The embed phase must run before Flutter's "Thin Binary" script.
thin = runner.build_phases.find { |p| p.respond_to?(:name) && p.name == 'Thin Binary' }
if thin
  runner.build_phases.delete(embed)
  runner.build_phases.insert(runner.build_phases.index(thin), embed)
end

if use_group
  configure_app_group(project, runner, ios_dir, 'Runner/Runner.entitlements', groups)
  configure_app_group(project, target, ios_dir, "#{name}/#{name}.entitlements", groups)
end
ensure_shared_intent(project, [runner, target], name)

project.save
puts "Added target #{name} for #{app_ids.values.compact.uniq.join(', ')}."

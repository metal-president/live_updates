/// The picture stored for `LiveUpdateContent.image`, or `nil`.
struct LiveUpdatesPhoto: View {
  let image: UIImage

  init?(name: String?) {
    guard let url = LiveUpdatesImages.url(name),
      let image = UIImage(contentsOfFile: url.path)
    else { return nil }
    self.image = image
  }

  var body: some View {
    Image(uiImage: image)
      .resizable()
      .scaledToFill()
      .clipShape(RoundedRectangle(cornerRadius: 8))
  }
}

/// An icon, else the default symbol. SF Symbols take `tint` (else the text
/// color); asset catalog images and Flutter assets keep their own colors
/// (asset catalog images set to render as template take the text color).
struct LiveUpdatesIconView: View {
  let icon: LiveUpdatesIcon?
  let tint: Color?

  var body: some View {
    let resolved = LiveUpdatesIconImage.resolve(icon) ?? .defaultSymbol
    resolved.view.resizable().scaledToFit()
      .foregroundStyle(resolved.isSymbol ? AnyShapeStyle(tint ?? .primary) : AnyShapeStyle(.primary))
  }
}

/// A `LiveUpdatesIcon` looked up in this extension.
struct LiveUpdatesIconImage {
  let view: Image
  let isSymbol: Bool

  /// Shown when there is no icon or it cannot be found.
  static let defaultSymbol = LiveUpdatesIconImage(
    view: Image(systemName: "bolt.circle.fill"), isSymbol: true)

  private static let log = Logger(subsystem: "live_updates", category: "icon")

  /// The image for `icon`, or `nil` (with a log message) when it cannot be
  /// found.
  static func resolve(_ icon: LiveUpdatesIcon?) -> LiveUpdatesIconImage? {
    guard let icon else { return nil }
    if let name = icon.native {
      if let image = UIImage(named: name) {
        return LiveUpdatesIconImage(view: Image(uiImage: image), isSymbol: false)
      }
      log.warning("No image \(name) in the widget extension's asset catalog")
    } else if let asset = icon.asset {
      if let url = LiveUpdatesImages.iconURL(asset: asset),
        let image = UIImage(contentsOfFile: url.path)
      {
        return LiveUpdatesIconImage(view: Image(uiImage: image), isSymbol: false)
      }
      log.warning(
        "Icon asset \(asset) was not stored by the app (see LiveUpdates.preloadIcons)"
      )
    } else if let symbol = icon.symbol {
      if UIImage(systemName: symbol) != nil {
        return LiveUpdatesIconImage(view: Image(systemName: symbol), isSymbol: true)
      }
      log.warning("No SF Symbols name \(symbol)")
    }
    return nil
  }
}

extension LiveUpdatesAttributes.ContentState {
  /// Delivered to `LiveUpdates.onTap` in Dart.
  var liveUpdatesTapURL: URL? {
    guard let route else { return nil }
    return liveUpdatesAppURL(host: "tap", [URLQueryItem(name: "route", value: route)])
  }

  // Values from a push are checked: about 3,000 years either way of 1970.
  var liveUpdatesTimerEnd: Date? { Self.liveUpdatesDate(timerEnd) }
  var liveUpdatesTimerStart: Date? { Self.liveUpdatesDate(timerStart) }
  var liveUpdatesHasTimer: Bool { liveUpdatesTimerEnd != nil || liveUpdatesTimerStart != nil }

  /// Whether to show `publicContent` instead of the full content: the system
  /// hides private data (the `privacy` redaction reason, for example on a
  /// locked Lock Screen, depending on the person's settings) and there is a
  /// `publicContent`.
  func liveUpdatesShowsPublic(_ reasons: RedactionReasons) -> Bool {
    reasons.contains(.privacy) && publicContent != nil
  }

  /// The content to show while private data is hidden: `publicContent`'s
  /// title and body with this content's icons, colors and tap route, its
  /// progress and timer unless `keepProgress` or `keepTimer` is false, and
  /// its Dynamic Island choices except `extra` values ("title" and "body"
  /// show the public text). Without a `publicContent`, only the title, icons,
  /// colors and tap route.
  var liveUpdatesPublicState: Self {
    let p = publicContent
    let keepProgress = p?.keepProgress ?? false
    let keepTimer = p?.keepTimer ?? false
    func island(_ choice: String?) -> String? {
      guard p != nil, let choice, !choice.hasPrefix("extra:") else { return nil }
      return choice
    }
    return Self(
      title: p?.title ?? title, body: p?.body, progress: keepProgress ? progress : nil,
      icon: icon, iosIcon: iosIcon, islandIcon: islandIcon, route: route,
      timerStart: keepTimer ? timerStart : nil, timerEnd: keepTimer ? timerEnd : nil,
      compactTrailing: island(compactTrailing), compactLeading: island(compactLeading),
      minimal: island(minimal),
      tintArgb: tintArgb, backgroundArgb: backgroundArgb, foregroundArgb: foregroundArgb)
  }

  /// `IosLiveUpdateOptions.color` for the Dynamic Island keyline.
  var liveUpdatesKeylineTint: Color? { LiveUpdatesPalette.color(tintArgb) }

  /// `layout` when its data is present ("timer" needs a timer, "metrics"
  /// metrics, "stepper" steps, "journey" a journey), else "standard". Other
  /// names are returned as they are, for layouts added to the layout file.
  var liveUpdatesLayout: String {
    switch layout {
    case "timer": return liveUpdatesHasTimer ? "timer" : "standard"
    case "metrics": return metrics.isEmpty ? "standard" : "metrics"
    case "stepper": return (steps?.labels.isEmpty ?? true) ? "standard" : "stepper"
    case "journey": return journey == nil ? "standard" : "journey"
    case let other?: return other
    case nil: return "standard"
    }
  }

  /// Text for "title", "body" or "extra:<key>".
  func liveUpdatesText(_ content: String) -> String? {
    switch content {
    case "title": return title
    case "body": return body
    default:
      guard content.hasPrefix("extra:") else { return nil }
      return extra[String(content.dropFirst("extra:".count))]
    }
  }

  /// `preferred` if it has something to show, else the first fallback that does.
  func liveUpdatesPick(_ preferred: String?, fallback: [String]) -> String? {
    ([preferred].compactMap { $0 } + fallback).first { liveUpdatesHas($0) }
  }

  private func liveUpdatesHas(_ content: String) -> Bool {
    switch content {
    case "progress": return progress != nil
    case "timer": return liveUpdatesHasTimer
    case "icon": return true
    default: return liveUpdatesText(content) != nil
    }
  }

  private static func liveUpdatesDate(_ seconds: Double?) -> Date? {
    guard let seconds, seconds.isFinite, abs(seconds) < 1e11 else { return nil }
    return Date(timeIntervalSince1970: seconds)
  }
}

extension View {
  /// `unredacted()` when `isPublic`: public content stays visible while the
  /// system hides private data.
  @ViewBuilder func liveUpdatesUnredacted(_ isPublic: Bool) -> some View {
    if isPublic {
      unredacted()
    } else {
      self
    }
  }
}

extension LiveUpdatesAction {
  /// Opens the app and delivers the press to `LiveUpdates.onAction`.
  func liveUpdatesURL(activityID: String) -> URL? {
    liveUpdatesAppURL(
      host: "action",
      [URLQueryItem(name: "activity", value: activityID), URLQueryItem(name: "action", value: id)])
  }
}

/// Must match LiveUpdatesBridge.tapScheme in the plugin:
/// "liveupdates-<app bundle id>", registered in Runner's Info.plist.
private func liveUpdatesAppURL(host: String, _ items: [URLQueryItem]) -> URL? {
  let appBundleId = (Bundle.main.bundleIdentifier ?? "")
    .split(separator: ".").dropLast().joined(separator: ".")
  var components = URLComponents()
  components.scheme = "liveupdates-\(appBundleId)"
  components.host = host
  components.queryItems = items
  return components.url
}

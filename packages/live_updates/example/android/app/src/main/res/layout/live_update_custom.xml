<?xml version="1.0" encoding="utf-8"?>
<!--
  Collapsed live update notification. Generated once by
  `dart run live_updates:create android` and yours to edit.
  Use it with
    AndroidLiveUpdateOptions(
      mode: AndroidLiveUpdateMode.ongoing,
      customLayout: AndroidCustomLayout('live_update_custom', expanded: 'live_update_custom_expanded'),
    )

  live_updates fills views with these ids (leave out the ones you do not need):
    live_update_title              TextView     LiveUpdateContent.title
    live_update_body               TextView     body (hidden without one)
    live_update_progress           ProgressBar  progress (hidden without one)
    live_update_timer              Chronometer  timer (hidden without one or when over)
    live_update_image              ImageView    image (hidden without one)
    live_update_extra_<key>        TextView     extra[key] (made visible)
    live_update_extra_image_<key>  ImageView    extraImages[key] (made visible)

  Android 12 and later draw this inside the system's notification frame; for
  apps that target Android 12 or later, the collapsed custom content is at
  most 48 dp high. Keep the text colors of
  the notification text appearances (no background color), so the layout
  reads well in light and dark themes.

  The tools: attributes only fill Android Studio's layout preview with sample
  content; they are not part of the app. Check the result on a device: the
  system's frame and colors differ between Android versions.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/live_update_title"
            tools:text="Order #1234"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

        <Chronometer
            android:id="@+id/live_update_timer"
            tools:text="12:34"
            tools:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Time"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/live_update_body"
        tools:text="On the way"
        tools:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/live_update_progress"
        tools:progress="60"
        tools:visibility="visible"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="2dp"
        android:maxHeight="4dp"
        android:minHeight="4dp"
        android:visibility="gone" />
</LinearLayout>

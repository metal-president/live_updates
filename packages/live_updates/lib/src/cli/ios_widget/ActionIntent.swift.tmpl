import AppIntents
import Foundation

/// Runs a live_updates button press in the app process without opening it.
///
/// Generated by `dart run live_updates:create_widget`. This file is compiled
/// into both the app and the widget extension; do not rename the types.
/// Marked iOS 17 so that apps with an older deployment target still build.
@available(iOS 17.0, *)
struct LiveUpdatesActionIntent: LiveActivityIntent {
  static var title: LocalizedStringResource = "Live update action"
  static var isDiscoverable = false

  @Parameter(title: "Activity")
  var activityId: String

  @Parameter(title: "Action")
  var actionId: String

  init() {}

  init(activityId: String, actionId: String) {
    self.activityId = activityId
    self.actionId = actionId
  }

  func perform() async throws -> some IntentResult {
    await LiveUpdatesActionRunner.run(activityId: activityId, actionId: actionId)
    return .result()
  }
}

/// Same as `LiveUpdatesActionIntent` for buttons with `requiresUnlock`: the
/// system asks for Face ID or the passcode on the Lock Screen first.
@available(iOS 17.0, *)
struct LiveUpdatesSecureActionIntent: LiveActivityIntent {
  static var title: LocalizedStringResource = "Live update action"
  static var isDiscoverable = false
  static var authenticationPolicy: IntentAuthenticationPolicy = .requiresAuthentication

  @Parameter(title: "Activity")
  var activityId: String

  @Parameter(title: "Action")
  var actionId: String

  init() {}

  init(activityId: String, actionId: String) {
    self.activityId = activityId
    self.actionId = actionId
  }

  func perform() async throws -> some IntentResult {
    await LiveUpdatesActionRunner.run(activityId: activityId, actionId: actionId)
    return .result()
  }
}

@available(iOS 17.0, *)
enum LiveUpdatesActionRunner {
  /// Hands the press to the live_updates plugin (looked up by name, so this
  /// file also compiles in the widget extension) and, when the Dart
  /// background handler runs it, waits until a run that took it finished (at
  /// most 30 seconds).
  static func run(activityId: String, actionId: String) async {
    // Listen before enqueueing so a quick "done" is not missed.
    let done = NotificationCenter.default.notifications(
      named: Notification.Name("LiveUpdatesBackgroundDone"))
    // 0: nothing to wait for; else the run count that covers this press.
    let takes = await MainActor.run { () -> Int in
      guard let bridge = NSClassFromString("LiveUpdatesBridge") as AnyObject?,
        let result = bridge.perform(
          NSSelectorFromString("enqueueAction:actionId:"), with: activityId, with: actionId)
      else { return 0 }
      return (result.takeUnretainedValue() as? NSNumber)?.intValue ?? 0
    }
    guard takes > 0 else { return }
    await withTaskGroup(of: Void.self) { group in
      group.addTask {
        for await note in done {
          if (note.userInfo?["takes"] as? Int ?? Int.max) >= takes { break }
        }
      }
      group.addTask { try? await Task.sleep(for: .seconds(30)) }
      await group.next()
      group.cancelAll()
    }
  }
}
